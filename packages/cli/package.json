{
  "name": "@0xwh1sker/mantle-aa-cli",
  "version": "0.1.3",
  "description": "The mantle-aa command: EIP-7702 smart accounts for AI agents on Mantle, with scoped session keys, an on-chain policy and sponsored execution.",
  "keywords": [
    "mantle",
    "eip-7702",
    "erc-4337",
    "account-abstraction",
    "smart-account",
    "session-keys",
    "ai-agents",
    "cli"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Whisker17/mantle-7702-sdk.git",
    "directory": "packages/cli"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "mantle-aa": "./dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@0xwh1sker/mantle-aa-sdk": "workspace:*",
    "@0xwh1sker/mantle-aa-sponsor": "workspace:*",
    "viem": "^2.43.4"
  }
}
