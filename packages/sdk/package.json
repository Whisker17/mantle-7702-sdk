    "mantle",
    "eip-7702",
    "erc-4337",
    "account-abstraction",
    "smart-account",
    "session-keys",
    "ai-agents",
    "viem"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Whisker17/mantle-7702-sdk.git",
    "directory": "packages/sdk"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "prepack": "pnpm run build"
  },
  "peerDependencies": {
