{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    // e2e/bundler/land-sepolia.ts runs under plain Node, which needs the real `.ts` extension.
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "paths": {
      "@mantle-aa/sdk": ["./packages/sdk/src/index.ts"],
      "@mantle-aa/sponsor": ["./packages/sponsor/src/index.ts"]
    }
  },
  "include": [
    "test/**/*.ts",
    "packages/*/src/**/*.ts",
    "packages/*/test/**/*.ts",
    "e2e/**/*.ts",
    "vitest.config.ts"
  ]
}
